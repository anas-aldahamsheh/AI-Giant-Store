# ─────────────────────────────────────────────
# Giant Store — environment variables
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
# ─────────────────────────────────────────────

# Public base URL of the site (used for metadata / Open Graph links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Application environment label
APP_ENV=local

# Google Gemini API key for the AI shopping assistant (optional).
# Get one from https://aistudio.google.com/apikey
# If left empty, the assistant falls back to the built-in local product advisor.
GEMINI_API_KEY=

# Set to "true" only when running behind a trusted reverse proxy,
# so the AI chat rate limiter can use the X-Forwarded-For header.
TRUST_PROXY_IP_HEADERS=false

# The store administrator (optional). The password is checked on the server only and is
# never sent to the browser. Without both values there is no administrator sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
